{
  "name": "postgres-jev",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.14"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/document.tsx --bundle --platform=node --format=esm --packages=external --outfile=server/document.js",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'server/**/*.ts' 'server/**/*.tsx' 'tests/**/*.ts' '*.ts' '*.json'",
    "test:extension": "node --import tsx extension/test/integration.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
