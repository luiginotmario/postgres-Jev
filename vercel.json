{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "dist/.vite/manifest.json"
    }
  },
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/api/index" }]
}
